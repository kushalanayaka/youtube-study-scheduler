# Database Configuration (PostgreSQL URL from Neon / Supabase)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth / Security Secrets
JWT_SECRET="your-secure-jwt-secret-min-32-chars-long"
CRON_SECRET="your-secure-cron-trigger-secret-key"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="your_telegram_bot_username"

# Application Base URL (Production Vercel Domain)
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# Optional SMTP / Email Service
RESEND_API_KEY=""
